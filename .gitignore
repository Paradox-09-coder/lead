# dependencies
/node_modules

# Legacy Express+MongoDB backend — superseded by the merged Next.js API
# routes (src/app/api/**). Kept locally for reference only; not deployed,
# and its config file has real dev credentials in a comment, so it must
# never be pushed to a remote.
server/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

